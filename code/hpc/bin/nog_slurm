#!/bin/bash

JOBS=""
SCOPE="last"
UPDATE_TIME=10
LIVE="false"
SELECT="false"
ON_START="false"
ENV4SCRIPT=""

MEM=16G
CPUs=8
GPU=""
TIME="08:00:00"
PARTITION="short"
CLUSTER="htc"
QOS=""
DELAY=""

# ── colours ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; GREEN='\033[0;32m'; BOLD='\033[1m'; NC='\033[0m'

# ── help ─────────────────────────────────────────────────────────────────────
function help {
    cat <<EOF
Usage: $(basename "$0") <action> [ACTION OPTIONS]

Actions:
  help           Show this help message
  submit         Submit a script as a SLURM batch job (must be .sh or .py)
  list           List your jobs (optional live view)
  info           Show detailed information about a job (optional live view)
  usage          Show current and maximum memory (optional live view)
  log            View log file of running job (optional live view)
  cancel         Cancel jobs
  exec           Execute a command when a job starts or finishes

Options for submit:
  -e <env>       Path to conda / mamba environment to activate before running (default: none)
  -c <cpus>      Number of CPUs requested (default: $CPUs)
  -g <gpu>       Set GPU specification. Uses --gres=<gpu> (default: no GPU)
  -m <mem>       Memory requested (default: $MEM)
  -p <partition> Partition to submit to (default: $PARTITION)
  -t <time>      Wall time limit (default: $TIME)
  -w [id]        Wait for a job to finish before starting. Without argument waits for
                 last submitted (default). Otherwise specify [id]. 
                 Uses --dependency=afterany:[id]
  -C <cluster>   Start job on specified cluster (default: $CLUSTER)
  -l             Live update of log every $UPDATE_TIME seconds
  -q <qos>       Set QOS specification. Uses --qos=<qos> (default: account default)
  -d <time>      Delay job start. Uses --begin=<time>, e.g. now+8hours, 16:00,
                 2026-10-09T07:00 (default: no delay)

Options for list:
  (none)         List all current jobs
  -l             Live update every $UPDATE_TIME seconds
  -C <cluster>   Show result for specified cluster (default: $CLUSTER)

Options for info:
  (none)         Show info for last submitted job
  -j <id[,id]>   Show info for specified comma-separated job IDs
                 (also works for finished jobs, via sacct)
  -a             Show info for ALL your jobs on $CLUSTER
  -s             Shows list of jobs. Select via comma seperated indices.
  -l             Live update every $UPDATE_TIME seconds
  -C <cluster>   Show result for specified cluster (default: $CLUSTER)

Options for usage:
  (none)         Show output for last submitted job
  -j <id>        Show output for a specific job ID
  -l             Live update every $UPDATE_TIME seconds
  -s             Shows list of jobs. Select job via index.
  -C <cluster>   Show result for specified cluster (default: $CLUSTER)

Options for log:
  (none)         Show output for last submitted job
  -j <id>        Show output for a specific job ID
  -l             Live update every $UPDATE_TIME seconds
  -s             Shows list of jobs. Select job via index.
  -C <cluster>   Show result for specified cluster (default: $CLUSTER)

Options for cancel:
  (none)         Cancel last submitted job
  -a             Cancel ALL jobs on $CLUSTER
  -j <id[,id]>   Cancel specified comma-separated job IDs
  -s             Shows list of jobs. Select via comma seperated indices.
  -C <cluster>   Operate on jobs for specified cluster (default: $CLUSTER)

Options for exec:
  (none)         Watch last submitted job, execute when finished
  -j <id>        Watch a specific job ID
  -s             Shows list of jobs. Select job to watch via index.
  -r             Execute when job starts running (default: wait for finish)
  -C <cluster>   Operate on jobs for specified cluster (default: $CLUSTER)

Examples:
  $(basename "$0") submit MyScript.sh           # submit bash script with defaults
  $(basename "$0") submit -e MyEnv -g 1 -m 32G -c 16 -t 24:00:00 -p long MyScript.py arg1 arg2

  $(basename "$0") submit -w MyScript.py        # wait for last submitted job to finish before running
  $(basename "$0") submit -w 12345 MyScript.py  # wait for job 12345 to finish before running

  $(basename "$0") list                         # list current jobs on $CLUSTER
  $(basename "$0") list -C arc -l               # list current jobs on arc, live update

  $(basename "$0") usage -j 12345               # report usage for job 12345
  $(basename "$0") usage -j 12345 -l            # live update for job 12345

  $(basename "$0") log -l                       # Show log file for last job, live update
  $(basename "$0") log -j 12345                 # Show log file for job 12345

  $(basename "$0") cancel                       # cancel last job on $CLUSTER
  $(basename "$0") cancel -s                    # cancel selected jobs on $CLUSTER

  $(basename "$0") cancel -a -C arc             # cancel all jobs on arc
  $(basename "$0") cancel -j 12345,12346        # cancel specific jobs on $CLUSTER

  $(basename "$0") exec "echo done"             # Print "done" after last submitted job finished
  $(basename "$0") exec -r "echo started"       # Print "started" after last submitted job started
  $(basename "$0") exec -s -r "bash notify.sh"  # select job, run script on start

  $(basename "$0") info                         # info for last submitted job
  $(basename "$0") info -j 12345                # info for job 12345 (running, pending or finished)
  $(basename "$0") info -a -C arc               # info for all your jobs on arc
  $(basename "$0") info -s -l                   # select jobs, live update
EOF
}

# ── functions ────────────────────────────────────────────────────────────────
function submit {
    [[ -z "$1" ]] && { echo -e "${RED}ERROR: No script provided.${NC}" >&2; help; exit 1; }

    mkdir -p "$DATA/logs"
    local SCRIPT_PATH="$(realpath "$1")"
    local SCRIPT_NAME="$(basename "${1%.*}")"
    local SCRIPT_EXT="${1##*.}"
    local ENVACT=""

    [[ -n "${ENV4SCRIPT}"  ]] && ENVACT="source activate $(realpath "${ENV4SCRIPT}")"
    case $SCRIPT_EXT in
        sh)   INTERPRETER="bash" ;;
        py)   INTERPRETER="python" ;;
        *) echo -e "${RED}ERROR: Function not implemented for .${SCRIPT_EXT} scripts yet.${NC}" >&2; help; exit 1 ;;
    esac
    local GPU_DIRECTIVE=""
    [[ -n "$GPU" ]] && GPU_DIRECTIVE="#SBATCH --gres=gpu:${GPU}"

    local QOS_DIRECTIVE=""
    [[ -n "$QOS" ]] && QOS_DIRECTIVE="#SBATCH --qos=${QOS}"

    local DEL_DIRECTIVE=""
    [[ -n "$DELAY" ]] && DEL_DIRECTIVE="#SBATCH --begin=${DELAY}"

    local DEP_DIRECTIVE=""
    if [[ -n "$JOBS" ]]; then
        DEP_DIRECTIVE="#SBATCH --dependency=afterany:${JOBS}"
        echo -e "${CYAN}Will wait for job ${JOBS} to complete before starting.${NC}"
    fi

JOBID=$(sbatch --parsable <<EOF
#!/bin/bash
#SBATCH --partition=$PARTITION
#SBATCH --job-name=$SCRIPT_NAME
#SBATCH --cpus-per-task=$CPUs
#SBATCH --mem=$MEM
#SBATCH --time=$TIME
#SBATCH --clusters=$CLUSTER
#SBATCH --output=$DATA/logs/$SCRIPT_NAME-%j.log
#SBATCH --error=$DATA/logs/$SCRIPT_NAME-%j.log
$GPU_DIRECTIVE
$DEP_DIRECTIVE
$QOS_DIRECTIVE
$DEL_DIRECTIVE

# source bashrc and, if requested, activate environment
source $HOME/.bashrc
$ENVACT

$INTERPRETER "${SCRIPT_PATH}" ${@:2}

EOF
)
[[ $CLUSTER == "all" ]] && CLUSTER=$(echo "$JOBID" | cut -d';' -f2)
JOBID=$(echo "$JOBID" | cut -d';' -f1)
[[ -z "$JOBID" ]] && { echo -e "${RED}ERROR: Submission failed (see sbatch message above).${NC}" >&2; exit 1; }
echo -e "${CYAN}Submitted job ${JOBID} to ${CLUSTER} ${NC}"

if [[ "$LIVE" == "true" ]];then
    JOBS="$JOBID"
    echo -e "${CYAN}Waiting for job ${JOBID} to start...${NC}"
    local log="${DATA}/logs/${SCRIPT_NAME}-${JOBID}.log"
    while [[ ! -f "$log" ]]; do
        sleep 5
    done
    log_view
fi
}

function select_jobs {
    local action="${1:-cancel}"
    local raw
    mapfile -t raw < <(squeue -u "$USER" --clusters "$CLUSTER" 2>/dev/null \
                        | grep -v '^CLUSTER:')

    if [[ ${#raw[@]} -le 1 ]]; then
        echo -e "${YELLOW}No jobs found for $USER on cluster '$CLUSTER'.${NC}"
        return 0
    fi

    echo -e "${CYAN}── Jobs for $USER on '$CLUSTER' ──${NC}"
    echo -e "${CYAN}       ${raw[0]}${NC}"  # header
    for i in "${!raw[@]}"; do
        [[ $i -eq 0 ]] && continue
        echo -e "  ${CYAN}[$((i-1))]${NC}  ${raw[$i]}"
    done

    echo ""
    case $action in
        log)    read -r -p "Enter index of job to view log (e.g. 1): " selection ;;
        cancel) read -r -p "Enter comma-separated indices to cancel (e.g. 0,2,3): " selection ;;
        usage)  read -r -p "Enter index of job to display usage (e.g. 1): " selection ;;
        exec)   read -r -p "Enter index of job to watch (e.g. 1): " selection ;;
        info)   read -r -p "Enter comma-separated indices to show info for (e.g. 0,2): " selection ;;
    esac

    local all_ids=()
    for i in "${!raw[@]}"; do
        [[ $i -eq 0 ]] && continue
        all_ids+=("$(awk '{print $1}' <<< "${raw[$i]}")")
    done

    local selected_ids=()
    IFS=',' read -ra indices <<< "$selection"
    for idx in "${indices[@]}"; do
        idx="${idx// /}"
        if [[ ! "$idx" =~ ^[0-9]+$ ]] || (( idx >= ${#all_ids[@]} )); then
            echo -e "${RED}Invalid index: $idx — skipping.${NC}" >&2
            continue
        fi
        selected_ids+=("${all_ids[$idx]}")
    done

    if [[ ${#selected_ids[@]} -eq 0 ]]; then
        echo -e "${YELLOW}No valid jobs selected.${NC}"
        return 0
    fi

    JOBS=$(IFS=','; echo "${selected_ids[*]}")
}

function get_jobs {
    # JOBS already set explicitly via -j: use as-is.
    if [[ -n "$JOBS" ]]; then
        return 0
    fi

    # last line is the most recently submitted job.
    local all_ids
    all_ids=$(squeue -u "$USER" --clusters "$CLUSTER" -h -o '%i %V' 2>/dev/null | sort -k2 | awk '{print $1}')

    if [[ -z "$all_ids" ]]; then
        echo -e "${YELLOW}No jobs found for $USER on cluster '$CLUSTER'.${NC}" >&2
        return 0
    fi

    if [[ "$SCOPE" == "all" ]]; then
        JOBS=$(echo "$all_ids" | tr '\n' ',' | sed 's/,$//')
    else
        # Default: most recently submitted job only.
        JOBS=$(echo "$all_ids" | tail -n 1)
    fi
}

function cancel_jobs {
    # if requested promt for job selection
    if [[ "$SELECT" == "true" ]]; then
        select_jobs "cancel"

        # if no jobs were selected, do not proceed.
        [[ -z "$JOBS" ]] && return 0
    fi

    get_jobs

    if [[ -z "$JOBS" ]]; then
        echo -e "${YELLOW}Nothing to cancel.${NC}"
        return 0
    fi

    echo -e "${CYAN}Jobs to cancel on '$CLUSTER': ${JOBS}${NC}"
    read -r -p "Are you sure you want to cancel these jobs? [y/N] " confirm
    if [[ "${confirm,,}" != "y" ]]; then
        echo "Aborted."
        return 0
    fi

    IFS=',' read -ra JOB_ARRAY <<< "$JOBS"
    if scancel --clusters "$CLUSTER" "${JOB_ARRAY[@]}"; then
        echo -e "${CYAN}Cancelled: ${JOBS}${NC}"
    else
        echo -e "${RED}scancel returned an error – check output above.${NC}" >&2
        return 1
    fi
}

function res_use {
    # if requested promt for job selection
    if [[ "$SELECT" == "true" ]]; then
        select_jobs "usage"

        # if no jobs were selected, do not proceed.
        [[ -z "$JOBS" ]] && return 0
    fi

    get_jobs

    if [[ -z "$JOBS" ]]; then
        echo -e "${YELLOW}No jobs to report on.${NC}"
        return 0
    fi
    IFS=',' read -ra JOB_ARRAY <<< "$JOBS"
    JOB="${JOB_ARRAY[-1]}"

    local step
    step=$(sacct -j "$JOB" --clusters "$CLUSTER" \
           --format=JobID%-30 2>/dev/null \
           | tr -d ' ' \
           | grep -v "^$JOB$" \
           | grep -v "\.extern$" \
           | tail -1)
    
    if [[ -z "$step" ]]; then
        echo -e "${RED}No active steps found for job $JOB.${NC}" >&2
        return 1
    fi
    
    echo -e "${CYAN}── sstat report for step $step ──${NC}"
    if [[ "$LIVE" == "true" ]];then
        watch -n $UPDATE_TIME sstat -j "$step" --format=AveCPU,AveRSS,MaxRSS || echo -e "${RED}sstat failed for job $JOB${NC}" >&2
    else
        sstat -j "$step" --format=AveCPU,AveRSS,MaxRSS || echo -e "${RED}sstat failed for job $JOB${NC}" >&2
    fi
}

function list_view {
    if [[ "$LIVE" == "true" ]];then
        watch -n $UPDATE_TIME squeue -u "$USER" --clusters "$CLUSTER"
    else
        squeue -u "$USER" --clusters "$CLUSTER"
    fi
}

function log_view {
    # if requested promt for job selection
    if [[ "$SELECT" == "true" ]]; then
        select_jobs "log"

        [[ -z "$JOBS" ]] && return 0
        if [[ "$JOBS" == *","* ]]; then
            echo -e "${YELLOW}Please select only one job.${NC}"
            return 0
        fi
    fi

    get_jobs
    [[ -z "$JOBS" ]] && { echo -e "${YELLOW}No jobs to report on.${NC}"; return 0; }

    IFS=',' read -ra JOB_ARRAY <<< "$JOBS"
    JOB="${JOB_ARRAY[-1]}"

    local job_name
    job_name=$(scontrol show job "$JOB" --clusters "$CLUSTER" | grep -oP 'JobName=\K\S+')

    [[ -z "$job_name" ]] && { echo -e "${RED}Could not resolve job name for $JOB.${NC}" >&2; return 1; }

    local log="$DATA/logs/${job_name}-${JOB}.log"

    [[ ! -f "$log" ]] && { echo -e "${RED}Log file not found: $log${NC}" >&2; return 1; }

    if [[ "$LIVE" == "true" ]]; then
        tail -f "$log"
    else
        cat "$log"
    fi
}

function _row {
    [[ -z "$2" ]] && return 0
    printf "  ${CYAN}%-15s${NC} %b\n" "$1" "$2"
}
 
function _section {
    printf "\n  ${BOLD}%s${NC}\n" "$1"
}

# 2026-10-28T11:25:00 -> 2026-10-28 11:25:00 (leaves Unknown/None/N/A untouched)
function _fmt_date {
    local t="$1"
    [[ "$t" =~ ^[0-9]{4}- ]] && t="${t/T/ }"
    echo "$t"
}

# [D-]HH:MM:SS | MM:SS -> seconds (empty if unparseable, e.g. UNLIMITED)
function _to_sec {
    local t="$1" d=0 h=0 m=0 s=0
    [[ "$t" =~ ^([0-9]+-)?[0-9:]+$ ]] || return 0
    if [[ "$t" == *-* ]]; then d="${t%%-*}"; t="${t#*-}"; fi
    local p; IFS=':' read -ra p <<< "$t"
    case ${#p[@]} in
        3) h=${p[0]}; m=${p[1]}; s=${p[2]} ;;
        2) m=${p[0]}; s=${p[1]} ;;
        1) m=${p[0]} ;;   # SLURM treats a single number as minutes
    esac
    echo $(( 10#$d*86400 + 10#$h*3600 + 10#$m*60 + 10#$s ))
}

# seconds -> [D-]HH:MM:SS
function _fmt_dur {
    local s="$1" d h m
    d=$(( s / 86400 )); h=$(( s % 86400 / 3600 )); m=$(( s % 3600 / 60 )); s=$(( s % 60 ))
    if (( d > 0 )); then printf "%d-%02d:%02d:%02d" "$d" "$h" "$m" "$s"
    else printf "%02d:%02d:%02d" "$h" "$m" "$s"; fi
}

function _state_colour {
    case "$1" in
        RUNNING|COMPLETED|COMPLETING)            echo -e "${GREEN}$1${NC}" ;;
        PENDING|CONFIGURING|SUSPENDED|REQUEUED*) echo -e "${YELLOW}$1${NC}" ;;
        *)                                       echo -e "${RED}$1${NC}" ;;
    esac
}

# position of a pending job in its partition's queue, by priority
function _queue_rank {
    local job="$1" part="$2"
    squeue --clusters "$CLUSTER" -p "$part" -t PD -h -o '%Q %i' 2>/dev/null \
        | grep -v '^CLUSTER:' \
        | sort -k1,1nr \
        | awk -v id="$job" -v p="$part" \
              '{a[NR]=$2} END {for (i=1;i<=NR;i++) if (a[i]==id) {printf "#%d of %d pending in %s", i, NR, p; exit}}'
}

# info for a job still known to slurmctld (pending / running / just finished)
function _info_scontrol {
    local JOB="$1" line="$2"
    local -A F=()
    local parts kv
    read -ra parts <<< "$line"
    for kv in "${parts[@]}"; do
        [[ "$kv" == *=* ]] || continue
        F["${kv%%=*}"]="${kv#*=}"
    done

    local state="${F[JobState]}"
    local reason="${F[Reason]}"
    local tres="${F[ReqTRES]:-${F[TRES]}}"

    # memory: per node or per CPU, depending on how it was requested
    local mem=""
    if [[ -n "${F[MinMemoryNode]}" ]]; then
        mem="${F[MinMemoryNode]} per node"
    elif [[ -n "${F[MinMemoryCPU]}" ]]; then
        mem="${F[MinMemoryCPU]} per CPU"
    else
        mem=$(grep -oP '(^|,)mem=\K[^,]+' <<< "$tres")
    fi

    # GPUs from TRES, e.g. gres/gpu=2 or gres/gpu:a100=2
    local gpus
    gpus=$(grep -oP 'gres/gpu(:[^=,]+)?=\K[0-9]+' <<< "$tres" | head -1)
    local gpu_type
    gpu_type=$(grep -oP 'gres/gpu:\K[^=,]+' <<< "$tres" | head -1)
    [[ -n "$gpu_type" && -n "$gpus" ]] && gpus="$gpus ($gpu_type)"

    # priority + queue position for pending jobs
    local prio="${F[Priority]}"
    if [[ "$state" == "PENDING" ]]; then
        local rank; rank=$(_queue_rank "$JOB" "${F[Partition]}")
        [[ -n "$rank" ]] && prio="$prio  ($rank)"
    fi

    # times
    local start; start=$(_fmt_date "${F[StartTime]}")
    local end;   end=$(_fmt_date "${F[EndTime]}")
    if [[ "$state" == "PENDING" ]]; then
        [[ "$start" == "Unknown" || -z "$start" ]] && start="Unknown (not yet scheduled)" || start="$start (estimated)"
        end=""
    elif [[ "$state" == "RUNNING" ]]; then
        end="$end (at time limit)"
    fi

    local limit="${F[TimeLimit]}"
    local runtime="${F[RunTime]}"
    local timeleft=""
    if [[ "$state" == "RUNNING" ]]; then
        local lim_s run_s
        lim_s=$(_to_sec "$limit"); run_s=$(_to_sec "$runtime")
        if [[ -n "$lim_s" && -n "$run_s" && "$lim_s" -gt 0 ]]; then
            timeleft="$(_fmt_dur $(( lim_s - run_s )))  ($(( run_s * 100 / lim_s ))% used)"
        fi
    fi

    local dep="${F[Dependency]}"
    [[ "$dep" == "(null)" ]] && dep=""
    local nodes="${F[NodeList]}"
    [[ "$nodes" == "(null)" ]] && nodes=""

    local state_str; state_str=$(_state_colour "$state")
    [[ -n "$reason" && "$reason" != "None" ]] && state_str="$state_str  (reason: $reason)"

    local log="$DATA/logs/${F[JobName]}-${JOB}.log"
    [[ -f "$log" ]] || log="${F[StdOut]}"

    printf "${CYAN}── Job %s on '%s' ──${NC}\n" "$JOB" "$CLUSTER"

    _section "General"
    _row "Name"         "${F[JobName]}"
    _row "State"        "$state_str"
    _row "Partition"    "${F[Partition]}"
    _row "QOS"          "${F[QOS]}"
    _row "Account"      "${F[Account]}"
    _row "Priority"     "$prio"
    _row "Dependency"   "$dep"

    _section "Resources"
    _row "CPUs"         "${F[NumCPUs]}"
    _row "Memory"       "$mem"
    _row "GPUs"         "$gpus"
    _row "Nodes"        "${F[NumNodes]}"
    _row "Node list"    "$nodes"

    _section "Time"
    _row "Submitted"    "$(_fmt_date "${F[SubmitTime]}")"
    _row "Eligible"     "$(_fmt_date "${F[EligibleTime]}")"
    _row "Start Time"   "$start"
    _row "End Time"     "$end"
    _row "Req Runtime"  "$limit"
    [[ "$state" != "PENDING" ]] && _row "Elapsed" "$runtime"
    _row "Time left"    "$timeleft"

    _section "Files"
    _row "Log"          "$log"
    _row "Work dir"     "${F[WorkDir]}"
    echo ""
}

# fallback for jobs that have left the queue: use accounting (sacct)
function _info_sacct {
    local JOB="$1"
    local line
    line=$(sacct -j "$JOB" --clusters "$CLUSTER" -X -n -P \
           --format=JobName,State,Partition,QOS,Account,AllocCPUS,ReqMem,AllocTRES,Timelimit,Elapsed,Submit,Eligible,Start,End,NodeList,ExitCode,WorkDir \
           2>/dev/null | head -1)

    if [[ -z "$line" ]]; then
        echo -e "${RED}Job $JOB not found on cluster '$CLUSTER' (neither in queue nor in accounting).${NC}" >&2
        return 1
    fi

    local name state part qos acct cpus reqmem tres limit elapsed submit eligible start end nodes exitcode workdir
    IFS='|' read -r name state part qos acct cpus reqmem tres limit elapsed submit eligible start end nodes exitcode workdir <<< "$line"

    local gpus
    gpus=$(grep -oP 'gres/gpu(:[^=,]+)?=\K[0-9]+' <<< "$tres" | head -1)

    # peak memory across all job steps
    local peak
    peak=$(sacct -j "$JOB" --clusters "$CLUSTER" -n -P --format=MaxRSS 2>/dev/null \
           | grep -v '^$' | sort -h | tail -1 \
           | awk '{v=$1; u=substr(v,length(v)); n=v+0;
                   if (u=="K") n*=1024; else if (u=="M") n*=1048576; else if (u=="G") n*=1073741824;
                   if (n>=1073741824) printf "%.1fG", n/1073741824; else printf "%.0fM", n/1048576}')

    [[ "$nodes" == "None assigned" ]] && nodes=""

    local log="$DATA/logs/${name}-${JOB}.log"
    [[ -f "$log" ]] || log=""

    printf "${CYAN}── Job %s on '%s' (finished, from accounting) ──${NC}\n" "$JOB" "$CLUSTER"

    _section "General"
    _row "Name"         "$name"
    _row "State"        "$(_state_colour "${state%% *}")"
    _row "Exit code"    "$exitcode"
    _row "Partition"    "$part"
    _row "QOS"          "$qos"
    _row "Account"      "$acct"
    _row "Priority"     "n/a (job no longer queued)"

    _section "Resources"
    _row "CPUs"         "$cpus"
    _row "Memory"       "$reqmem requested${peak:+, peak $peak used}"
    _row "GPUs"         "$gpus"
    _row "Node list"    "$nodes"

    _section "Time"
    _row "Submitted"    "$(_fmt_date "$submit")"
    _row "Eligible"     "$(_fmt_date "$eligible")"
    _row "Start Time"   "$(_fmt_date "$start")"
    _row "End Time"     "$(_fmt_date "$end")"
    _row "Req Runtime"  "$limit"
    _row "Elapsed"      "$elapsed"

    _section "Files"
    _row "Log"          "$log"
    _row "Work dir"     "$workdir"
    echo ""
}

function job_info {
    # if requested promt for job selection
    if [[ "$SELECT" == "true" ]]; then
        select_jobs "info"
        [[ -z "$JOBS" ]] && return 0
    fi
 
    get_jobs
    [[ -z "$JOBS" ]] && { echo -e "${YELLOW}No jobs to report on.${NC}"; return 0; }
 
    # live view: re-run this script for the resolved jobs under watch
    if [[ "$LIVE" == "true" ]]; then
        watch -c -n "$UPDATE_TIME" "$(realpath "$0")" info -j "$JOBS" -C "$CLUSTER"
        return
    fi

    IFS=',' read -ra JOB_ARRAY <<< "$JOBS"
    local JOB line
    for JOB in "${JOB_ARRAY[@]}"; do
        line=$(scontrol show job "$JOB" --clusters "$CLUSTER" -o 2>/dev/null \
               | grep '^JobId=' | head -1)
        if [[ -n "$line" ]]; then
            _info_scontrol "$JOB" "$line"
        else
            _info_sacct "$JOB"
        fi
    done
}

function run_on_job {
    [[ $# -ne 1 ]] && { echo -e "${RED}ERROR: Command must be a single quoted string, e.g. \"echo hi\"${NC}" >&2; exit 1; }

    if [[ "$SELECT" == "true" ]]; then
        select_jobs "exec"
        [[ -z "$JOBS" ]] && return 0
    fi

    get_jobs
    [[ -z "$JOBS" ]] && return 0

    IFS=',' read -ra JOB_ARRAY <<< "$JOBS"
    local JOB="${JOB_ARRAY[-1]}"

    if [[ "$ON_START" == true ]]; then
        echo -e "${CYAN}Waiting for job ${JOB} to start...${NC}"
        while true; do
            local STATUS
            STATUS=$(squeue -j "$JOB" --clusters "$CLUSTER" -h -o '%T' 2>/dev/null)
            [[ "$STATUS" == "RUNNING" ]] && break
            if [[ -z "$STATUS" ]]; then
                echo -e "${YELLOW}Job ${JOB} is no longer in the queue.${NC}"
                return 0
            fi
            sleep "$UPDATE_TIME"
        done
        echo -e "${CYAN}Job ${JOB} started.${NC}"
    else
        echo -e "${CYAN}Waiting for job ${JOB} to finish...${NC}"
        while squeue -j "$JOB" --clusters "$CLUSTER" -h 2>/dev/null | grep -q .; do
            sleep "$UPDATE_TIME"
        done
        echo -e "${CYAN}Job ${JOB} finished.${NC}"
    fi

    echo -e "${CYAN}Executing: ${*}${NC}"
    eval "${@}"
}

# ── Determine action ─────────────────────────────────────────────────────────
case "${1:-help}" in
    help)   help; exit 0 ;;
    list)   ACTION="list" ;;
    info)   ACTION="info" ;;
    usage)  ACTION="usage" ;;
    cancel) ACTION="cancel" ;;
    submit) ACTION="submit" ;;
    log)    ACTION="log" ;;
    exec)   ACTION="exec" ;;
    *)      echo -e "${RED}Unknown action: $1${NC}" >&2; help; exit 64 ;;
esac
shift

# ── Parse per-action options (after the action keyword) ──────────────────────
if [[ "$ACTION" == "list" ]]; then
    while getopts ":lC:" opts; do
        case $opts in
            l) LIVE="true" ;;
            C) CLUSTER="$OPTARG" ;;
            :) echo -e "${RED}Option -$OPTARG requires an argument.${NC}" >&2; help; exit 64 ;;
            *) echo -e "${RED}Illegal option -$OPTARG for ${ACTION}.${NC}" >&2; help; exit 64 ;;
        esac
    done
elif [[ "$ACTION" == "info" ]]; then
    while getopts ":alsj:C:" opts; do
        case $opts in
            a) SCOPE="all" ;;
            l) LIVE="true" ;;
            s) SELECT="true" ;;
            j) JOBS="$OPTARG" ;;
            C) CLUSTER="$OPTARG" ;;
            :) echo -e "${RED}Option -$OPTARG requires an argument.${NC}" >&2; help; exit 64 ;;
            *) echo -e "${RED}Illegal option -$OPTARG for ${ACTION}.${NC}" >&2; help; exit 64 ;;
        esac
    done
elif [[ "$ACTION" == "log" ]]; then
    while getopts ":lsj:C:" opts; do
        case $opts in
            l) LIVE="true" ;;
            s) SELECT="true" ;;
            j) JOBS="$OPTARG" ;;
            C) CLUSTER="$OPTARG" ;;
            :) echo -e "${RED}Option -$OPTARG requires an argument.${NC}" >&2; help; exit 64 ;;
            *) echo -e "${RED}Illegal option -$OPTARG for ${ACTION}.${NC}" >&2; help; exit 64 ;;
        esac
    done
elif [[ "$ACTION" == "usage" ]]; then
    while getopts ":lsj:C:" opts; do
        case $opts in
            s) SELECT="true" ;;
            l) LIVE="true" ;;
            j) JOBS="$OPTARG" ;;
            C) CLUSTER="$OPTARG" ;;
            :) echo -e "${RED}Option -$OPTARG requires an argument.${NC}" >&2; help; exit 64 ;;
            *) echo -e "${RED}Illegal option -$OPTARG for ${ACTION}.${NC}" >&2; help; exit 64 ;;
        esac
    done
elif [[ "$ACTION" == "cancel" ]]; then
    while getopts ":asj:C:" opts; do
        case $opts in
            s) SELECT="true" ;;
            j) JOBS="$OPTARG" ;;
            a) SCOPE="all" ;;
            C) CLUSTER="$OPTARG" ;;
            :) echo -e "${RED}Option -$OPTARG requires an argument.${NC}" >&2; help; exit 64 ;;
            *) echo -e "${RED}Illegal option -$OPTARG for ${ACTION}.${NC}" >&2; help; exit 64 ;;
        esac
    done
elif [[ "$ACTION" == "submit" ]]; then
    while getopts ":e:m:c:t:p:g:C:wlq:d:" opts; do
        case $opts in
            e) ENV4SCRIPT="$OPTARG" ;;
            m) MEM="$OPTARG" ;;
            c) CPUs="$OPTARG" ;;
            t) TIME="$OPTARG" ;;
            p) PARTITION="$OPTARG" ;;
            g) GPU="$OPTARG" ;;
            C) CLUSTER="$OPTARG" ;;
            l) LIVE="true" ;;
            q) QOS="$OPTARG" ;;
            d) DELAY="$OPTARG" ;;
            w)  if [[ "${!OPTIND}" =~ ^[0-9]+$ ]]; then
                    JOBS="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                else
                    get_jobs
                fi
                ;;
            :) echo -e "${RED}Option -$OPTARG requires an argument.${NC}" >&2; help; exit 64 ;;
            *) echo -e "${RED}Illegal option -$OPTARG for ${ACTION}.${NC}" >&2; help; exit 64 ;;
        esac
    done
    shift $((OPTIND - 1))
elif [[ "$ACTION" == "exec" ]]; then
    while getopts ":j:sC:r" opts; do
            case $opts in
                j) JOBS="$OPTARG" ;;
                s) SELECT="true" ;;
                C) CLUSTER="$OPTARG" ;;
                r) ON_START="true" ;;
                :) echo -e "${RED}Option -$OPTARG requires an argument.${NC}" >&2; help; exit 64 ;;
                *) echo -e "${RED}Illegal option -$OPTARG for exec.${NC}" >&2; help; exit 64 ;;
            esac
        done
    shift $((OPTIND - 1))
else
    echo -e "${RED}Illegal action ${ACTION}.${NC}" >&2; help; exit 64
fi

# ── Deploy ───────────────────────────────────────────────────────────────────
case $ACTION in
    help)   help ;;
    list)   list_view ;;
    info)   job_info ;;
    usage)  res_use ;;
    cancel) cancel_jobs ;;
    submit) submit "${@}" ;;
    log)    log_view ;;
    exec)   run_on_job "${@}" ;;
esac
