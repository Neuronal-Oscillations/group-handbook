#!/bin/bash

GPU=""
MEM=32G
CPUs=8
TIME="08:00:00"
PARTITION="short"
CLUSTER="htc"
SCRIPT_PATH=$(realpath "$0")
JUPYTERENV="${JUPYTERENV:-}"
USE_XVFB="${USE_XVFB:-false}"
QOS=""
DELAY=""

function help {
cat <<EOF
Usage: $(basename "$0") [-h] [-e JUPYTERENV] [-x] [-g GPU] [-m MEM] [-c CPUs] [-t TIME] [-p PARTITION] [-C CLUSTER] [-q QOS] [-d DELAY]
  -h  help
  -e  Path to conda / mamba environment to activate before running (required)
  -g  request GPU (default: no GPU)
  -m  memory (default: $MEM)
  -c  CPUs (default: $CPUs)
  -t  walltime (default: $TIME)
  -p  partition (default: $PARTITION)
  -C  cluster (default: $CLUSTER)
  -x  start a virtual X display (Xvfb) for plotting/GUI libraries
  -q <qos> Set QOS specification. Uses --qos=<qos> (default: account default)
  -d <time> Delay job start. Uses --begin=<time>, e.g. now+8hours, 16:00,
            2026-10-09T07:00 (default: no delay)

Example: 
  nog_jupyter_server -e /Path/to/MyEnv -m 16G -c 8 -t 24:00:00 -p medium -C htc
EOF
}

function init_env_vars {
    # Validate early on the login node so user isn't queued in Slurm with invalid inputs
    if [[ -z "${JUPYTERENV}" ]]; then
        echo -e "ERROR: No jupyter environment provided (-e is required)." >&2
        help
        exit 1
    fi

    export JUPYTERENV USE_XVFB
}

function setup_jupyter {

source activate $(realpath "${JUPYTERENV}")
PORT=$(python -c "import socket; s=socket.socket(); s.bind(('',0)); print(s.getsockname()[1]); s.close()")
HOSTNAME=$(hostname)

echo ""
echo "-------------------------------------------------------------------"
echo "JUPYTER IS STARTING"
echo "NODE: $HOSTNAME"
echo "PORT: $PORT"
echo ""
echo "SSH TUNNEL COMMAND FROM WINDOWS OR MAC:"
echo "ssh -X -L 8888:$HOSTNAME:$PORT $USER@gateway.arc.ox.ac.uk"
echo ""
echo "Link to be used in Windows or Mac browser:"
echo "URL: http://localhost:8888/tree?token=$USER"
echo ""
echo "Note that it can take some seconds up to minutes until the server is available."
echo "-------------------------------------------------------------------"

if [[ "$USE_XVFB" == "true" ]]; then
    Xvfb :99 -screen 0 1600x1200x24 -nolisten tcp &
    export DISPLAY=:99
fi

# Execute Jupyter
$JUPYTERENV/bin/jupyter notebook \
    --no-browser \
    --port=$PORT \
    --ip=$HOSTNAME \
    --notebook-dir=$DATA \
    --NotebookApp.token=$USER \
    --NotebookApp.password=''
}

function new_batch {
    local GPU_DIRECTIVE=""
    [[ -n "$GPU" ]] && GPU_DIRECTIVE="#SBATCH --gres=gpu:${GPU}"

    local QOS_DIRECTIVE=""
    [[ -n "$QOS" ]] && QOS_DIRECTIVE="#SBATCH --qos=${QOS}"

    local DEL_DIRECTIVE=""
    [[ -n "$DELAY" ]] && DEL_DIRECTIVE="#SBATCH --begin=${DELAY}"

    local JOBID
    JOBID=$(sbatch --parsable <<EOF
#!/bin/bash
#SBATCH --partition=$PARTITION
#SBATCH --job-name=jupyter
#SBATCH --cpus-per-task=$CPUs
#SBATCH --mem=$MEM
#SBATCH --time=$TIME
#SBATCH --clusters=$CLUSTER
#SBATCH --output=$DATA/logs/jupyter-%j.log
#SBATCH --error=$DATA/logs/jupyter-%j.log
${GPU_DIRECTIVE:-}
${QOS_DIRECTIVE:-}
${DEL_DIRECTIVE:-}

source "$HOME/.bashrc"
source "$SCRIPT_PATH"
setup_jupyter
EOF
)
    JOBID=$(echo "$JOBID" | cut -d';' -f1)
    [[ -z "$JOBID" ]] && { echo "ERROR: Submission failed (see sbatch message above)." >&2; exit 1; }
    echo "Job ${JOBID} submitted! Waiting for Jupyter to start ..."
    
    until [[ -f "$DATA/logs/jupyter-${JOBID}.log" ]]; do 
        sleep 2s
    done 
    tail -f "$DATA/logs/jupyter-${JOBID}.log"
}

function main {
    while getopts "hxg:m:c:t:p:C:e:q:d:" opts ; do
        case $opts in
            h) help; exit 0 ;;
            x) USE_XVFB="true" ;;
            e) JUPYTERENV="$OPTARG" ;;
            g) GPU="$OPTARG";;
            m) MEM="$OPTARG";;
            c) CPUs="$OPTARG";;
            C) CLUSTER="$OPTARG";;
            t) TIME="$OPTARG";;
            p) PARTITION="$OPTARG";;
            q) QOS="$OPTARG" ;;
            d) DELAY="$OPTARG" ;;
            *) echo "illegal option" >&2; help; exit 64 ;;
        esac
    done

    init_env_vars

    mkdir -p "$DATA/logs"
    
    new_batch
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] && main "$@"
