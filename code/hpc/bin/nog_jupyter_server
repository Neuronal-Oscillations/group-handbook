#!/bin/bash

GPU=""
MEM=32G
CPUs=8
TIME="08:00:00"
PARTITION="short"
CLUSTER="htc"
BATCH="false"
SCRIPT_PATH=$(realpath "$0")
JUPYTERENV="${JUPYTERENV:-}"

function help {
cat <<EOF
Usage: $(basename "$0") [-h] [-e JUPYTERENV] [-b] [-g GPU] [-m MEM] [-c CPUs] [-t TIME] [-p PARTITION] [-C CLUSTER]
  -h  help
  -e  Path to conda / mamba environment to activate before running (required)
  -b  run in batch mode via sbatch (default is interactive via srun)
  -g  request GPU (default: no GPU)
  -m  memory (default: $MEM)
  -c  CPUs (default: $CPUs)
  -t  walltime (default: $TIME)
  -p  partition (default: $PARTITION)
  -C  cluster (default: $CLUSTER)

Example: 
  nog_jupyter_server -e /Path/to/MyEnv -m 16G -c 8 -t 24:00:00 -p medium -C htc
EOF
}

function init_env_vars {
    # Validate early on the login node so user isn't queued in Slurm with invalid inputs
    if [[ -z "${JUPYTERENV}" ]]; then
        echo -e "ERROR: No jupyter environment provided (-e is required)." >&2
        help
        exit 1
    fi

    # Export so srun/sbatch pass JUPYTERENV to the compute node
    export JUPYTERENV
}

function setup_jupyter {

source activate $(realpath "${JUPYTERENV}")
PORT=$(python -c "import socket; s=socket.socket(); s.bind(('',0)); print(s.getsockname()[1]); s.close()")
HOSTNAME=$(hostname)

echo ""
echo "-------------------------------------------------------------------"
echo "JUPYTER IS STARTING"
echo "NODE: $HOSTNAME"
echo "PORT: $PORT"
echo ""
echo "Requested resources: MEM=$MEM, CPUs=$CPUs, TIME=$TIME"
echo ""
echo "SSH TUNNEL COMMAND FROM WINDOWS OR MAC:"
echo "ssh -L 8888:$HOSTNAME:$PORT $USER@gateway.arc.ox.ac.uk"
echo ""
echo "Link to be used in Windows or Mac browser:"
echo "URL: http://localhost:8888/tree?token=$USER"
echo ""
echo "Note that it can take some seconds up to minutes until the server is available."
echo "-------------------------------------------------------------------"

# Execute Jupyter
$JUPYTERENV/bin/jupyter notebook \
    --no-browser \
    --port=$PORT \
    --ip=$HOSTNAME \
    --notebook-dir=$DATA \
    --NotebookApp.token=$USER \
    --NotebookApp.password=''
}

function new_session {
    local GPU_DIRECTIVE=""
    [[ -n "$GPU" ]] && GPU_DIRECTIVE="--gres=gpu:${GPU}"
    
    # Note: Unquoted $GPU_DIRECTIVE is intentional so Bash drops it if it's empty
    srun \
      --partition="$PARTITION" \
      $GPU_DIRECTIVE \
      --cpus-per-task="$CPUs" \
      --mem="$MEM" \
      --time="$TIME" \
      --job-name=jupyter \
      --clusters="$CLUSTER" \
      --pty bash -c "source $HOME/.bashrc && source $SCRIPT_PATH && setup_jupyter"
}

function new_batch {
    local GPU_DIRECTIVE=""
    [[ -n "$GPU" ]] && GPU_DIRECTIVE="#SBATCH --gres=gpu:${GPU}"

    local JOBID
    JOBID=$(sbatch --parsable <<EOF
#!/bin/bash
#SBATCH --partition=$PARTITION
#SBATCH --job-name=jupyter
#SBATCH --cpus-per-task=$CPUs
#SBATCH --mem=$MEM
#SBATCH --time=$TIME
#SBATCH --clusters=$CLUSTER
#SBATCH --output=$DATA/logs/jupyter-%j.log
#SBATCH --error=$DATA/logs/jupyter-%j.log
${GPU_DIRECTIVE:-}

source "$HOME/.bashrc"
source "$SCRIPT_PATH"
setup_jupyter
EOF
)
    JOBID=$(echo "$JOBID" | cut -d';' -f1)
    echo "Job ${JOBID} submitted! Waiting for Jupyter to start ..."
    
    until [[ -f "$DATA/logs/jupyter-${JOBID}.log" ]]; do 
        sleep 2s
    done 
    tail -f "$DATA/logs/jupyter-${JOBID}.log"
}

function main {
    while getopts "hbg:m:c:t:p:C:e:" opts ; do
        case $opts in
            h) help; exit 0 ;;
            e) JUPYTERENV="$OPTARG" ;;
            b) BATCH="true" ;;
            g) GPU="$OPTARG";;
            m) MEM="$OPTARG";;
            c) CPUs="$OPTARG";;
            C) CLUSTER="$OPTARG";;
            t) TIME="$OPTARG";;
            p) PARTITION="$OPTARG";;
            *) echo "illegal option" >&2; help; exit 64 ;;
        esac
    done

    init_env_vars

    mkdir -p "$DATA/logs"
    
    if [[ "$BATCH" == "true" ]]; then
        new_batch
    else
        new_session
    fi
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] && main "$@"
